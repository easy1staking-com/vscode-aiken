{
  "name": "aiken",
  "displayName": "Aiken",
  "description": "Aiken language support for Visual Studio Code",
  "version": "1.0.11",
  "publisher": "txpipe",
  "icon": "images/aiken.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/txpipe/vscode-aiken"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "contributes": {
    "languages": [
      {
        "id": "aiken",
        "aliases": [
          "Aiken",
          "aiken"
        ],
        "extensions": [
          ".ak"
        ],
        "configuration": "./configs/aiken-configuration.json",
        "icon": {
          "light": "./images/aiken.png",
          "dark": "./images/aiken.png"
        }
      },
      {
        "id": "uplc",
        "aliases": [
          "Untyped Plutus Core",
          "uplc"
        ],
        "extensions": [
          ".uplc"
        ],
        "configuration": "./configs/uplc-configuration.json",
        "icon": {
          "light": "./images/plutus.png",
          "dark": "./images/plutus.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "aiken",
        "scopeName": "source.aiken",
        "path": "./syntaxes/aiken.tmLanguage.json"
      },
      {
        "language": "uplc",
        "scopeName": "source.uplc",
        "path": "./syntaxes/uplc.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "aiken",
        "path": "./snippets/aiken.json"
      }
    ],
    "configurationDefaults": {
      "[aiken]": {
        "editor.formatOnSave": true
      },
      "[uplc]": {
        "editor.formatOnSave": true
      }
    },
    "commands": [
      {
        "command": "aiken.restartServer",
        "title": "Aiken: Restart Language Server"
      }
    ],
    "taskDefinitions": [
      {
        "type": "aiken",
        "required": ["command"],
        "properties": {
          "command": {
            "type": "string",
            "description": "The aiken command to run (build, check, test, bench)"
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "aiken",
        "owner": "aiken",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^\\s*\\u250c\\u2500 (.+):(\\d+):(\\d+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 0
        }
      }
    ],
    "configuration": {
      "title": "Aiken",
      "properties": {
        "aiken.server.path": {
          "type": "string",
          "default": "",
          "description": "Path to the aiken binary. If empty, the extension will look for 'aiken' in PATH."
        },
        "aiken.server.formattingTimeout": {
          "type": "number",
          "default": 5000,
          "description": "Timeout in milliseconds for format-on-save requests. Set to 0 to disable."
        }
      }
    }
  },
  "activationEvents": [
    "onLanguage:aiken",
    "onLanguage:uplc"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run package",
    "build": "vsce package",
    "dev": "webpack --mode development --watch",
    "compile": "webpack --mode development",
    "package": "webpack --mode production --devtool hidden-source-map",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "22.x",
    "@types/vscode": "^1.82.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^3.0.0",
    "eslint": "^8.26.0",
    "glob": "^8.0.3",
    "mocha": "^10.1.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.7.0",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.1.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
